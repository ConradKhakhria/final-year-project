Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04
Stage: build

%labels
    Author YourName
    Version 2.1.0
    Description PyTorch 2.1.0 GPU container with CUDA 11.8 and Hugging Face

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/usr/local/bin:$PATH
    export FAKEROOTKEY=static-key-12345

%files
    $HOME/ACFS/final-year-project/constraints.txt /constraints.txt

%post
    echo "[INFO] Starting %post section"

    # Set up pip temp/cache dirs in writable /project
    mkdir -p /project/tmp/pip-cache /project/tmp/pip-tmp
    export TMPDIR=/project/tmp
    export PIP_CACHE_DIR=/project/tmp/pip-cache
    export PIP_TEMP_DIR=/project/tmp/pip-tmp

    # Install base packages
    apt-get update && apt-get install -y --no-install-recommends \
        python3.9 python3.9-venv python3.9-dev python3-pip \
        build-essential git wget ca-certificates && \
        rm -rf /var/lib/apt/lists/*

    ln -fs /usr/share/zoneinfo/Europe/London /etc/localtime
    dpkg-reconfigure --frontend noninteractive tzdata

    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1
    python3 -m pip install --upgrade pip setuptools wheel

    # Install core dependencies with version constraints
    python3 -m pip install --no-cache-dir --upgrade -c /constraints.txt \
        numpy \
        datasets \
        transformers==4.49.0 \
        pyarrow \
        sentencepiece \
        scikit-learn \
        "networkx<3.0"

    python3 -m pip install --no-cache-dir --upgrade -c /constraints.txt "accelerate>=0.26.0"

    # Bitsandbytes
    python3 -m pip install --no-cache-dir bitsandbytes==0.42.0

    # For flash-attention 2 (requires --no-build-isolation)
    python3 -m pip install --no-cache-dir flash_attn --no-build-isolation --no-binary :all:

    # Hatchling build backend
    python3 -m pip install --no-cache-dir hatchling

    # PyTorch + friends for CUDA 11.8
    python3 -m pip install --no-cache-dir --upgrade -c /constraints.txt \
        torch==2.1.0+cu118 \
        torchvision==0.16.0+cu118 \
        torchaudio==2.1.0+cu118 \
        --index-url https://download.pytorch.org/whl/cu118

    # Force-reinstall numpy < 2 for compatibility
    python3 -m pip install --no-cache-dir --force-reinstall "numpy<2"

    echo "[INFO] Installed versions:"
    python3 -m pip list | grep -E 'numpy|torch|transformers|bitsandbytes|accelerate|flash_attn'

    echo "[INFO] Verifying Torch + NumPy compatibility..."
    python3 -c "import torch, numpy; print(f'Torch version: {torch.__version__}, NumPy version: {numpy.__version__}')"
