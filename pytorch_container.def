Bootstrap: docker
From: nvidia/cuda:11.3.1-cudnn8-runtime-ubuntu20.04
Stage: build

%labels
    Author YourName
    Version 1.0
    Description PyTorch 1.11.0 container with CUDA 11.3.1 and Hugging Face support

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/usr/local/bin:$PATH

%post
    echo "Setting noninteractive frontend for apt"
    export DEBIAN_FRONTEND=noninteractive

    echo "Updating system and installing dependencies"
    apt-get update && apt-get install -y --no-install-recommends \
        python3.9 \
        python3.9-venv \
        python3.9-dev \
        python3-pip \
        build-essential \
        git \
        ca-certificates \
        wget && \
    rm -rf /var/lib/apt/lists/*

    echo "Configuring timezone (optional)"
    ln -fs /usr/share/zoneinfo/Europe/London /etc/localtime
    dpkg-reconfigure --frontend noninteractive tzdata

    echo "Setting python3 to point to python3.9"
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1

    echo "Upgrading pip"
    python3 -m pip install --upgrade pip

    echo "Installing PyTorch 1.11.0 for CUDA 11.3"
    python3 -m pip install torch==1.11.0+cu113 torchvision==0.12.0+cu113 torchaudio==0.11.0 \
        --extra-index-url https://download.pytorch.org/whl/cu113

    echo "Installing additional libraries: transformers, datasets, numpy, pandas"
    python3 -m pip install transformers datasets numpy pandas

%runscript
    exec python3 "$@"
