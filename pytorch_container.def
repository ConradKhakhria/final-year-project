%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3.9 \
        python3.9-venv \
        python3.9-dev \
        python3-pip \
        build-essential \
        ca-certificates \
        wget \
        git && \
    rm -rf /var/lib/apt/lists/*
    
    # Set default timezone if needed (optional)
    ln -fs /usr/share/zoneinfo/Europe/London /etc/localtime
    dpkg-reconfigure --frontend noninteractive tzdata

    # Make Python3.9 the default for python3
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1

    # Upgrade pip to the latest version
    python3 -m pip install --upgrade pip

    # Install PyTorch 1.11.0 (GPU version for CUDA 11.3) and its related libraries.
    python3 -m pip install torch==1.11.0+cu113 torchvision==0.12.0+cu113 torchaudio==0.11.0 --extra-index-url https://download.pytorch.org/whl/cu113

    # Install additional dependencies for your LLM workflow
    python3 -m pip install transformers datasets numpy pandas
